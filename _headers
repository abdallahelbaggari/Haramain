/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=(), usb=(), accelerometer=(self), gyroscope=(self), magnetometer=(self)
  Content-Security-Policy: object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/validation-key.txt
  Cache-Control: no-cache
  Content-Type: text/plain; charset=utf-8

/onboarding/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800
